# LLM settings for OpenRouter
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=qwen/qwen3.8-flash
OPENROUTER_MODEL_CAPABLE=qwen/qwen3.8-max-0902
OPENROUTER_MODEL_FALLBACKS=qwen/qwen3.7-plus
OPENROUTER_APP_URL=https://github.com/vikramlingam/excelpilot
OPENROUTER_APP_TITLE=ExcelPilot
OPENROUTER_REASONING_EFFORT=low

# TypeSafe settings for Jev
TYPESAFE_API_KEY=your_typesafe_key_here
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_FALLBACK_VIA_OPENROUTER=true
JEV_APPROVE_THRESHOLD=0.85
JEV_BLOCK_THRESHOLD=0.15
JEV_VERIFY_ACCEPT_CONFIDENCE=0.80

# Server settings
EXCELPILOT_HOST=127.0.0.1
EXCELPILOT_PORT=8765
EXCELPILOT_ADDIN_ORIGIN=https://localhost:3000
EXCELPILOT_DATA_DIR=~/.excelpilot
EXCELPILOT_REDACTION=pii
EXCELPILOT_ALWAYS_ASK_BEFORE_WRITES=false
EXCELPILOT_PAGE_CELLS=4000
EXCELPILOT_DAILY_BUDGET_USD=5
EXCELPILOT_BRIDGE_PREFERENCE=officejs,xlwings,file

# Observability
LOGFIRE_TOKEN=
LOG_LEVEL=INFO
