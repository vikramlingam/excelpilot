# ExcelPilot local config. Copy to .env. Still under development.
# Chat model (writes formulas, talks in the pane) is OpenRouter.
# Jev is a separate judge used on destructive tools only. See README.

# LLM settings for OpenRouter
OPENROUTER_API_KEY=your_openrouter_key_here
# Benchmarked 2026-09-20 on a 2-tool Excel task (parallel tool calls, reasoning off):
#   inception/mercury-2.5 743ms · qwen/qwen3.5-flash-02-23 1.28s · openai/gpt-5.6-luna 1.7s · qwen/qwen3.8-flash 1.8s
OPENROUTER_MODEL=inception/mercury-2.5
OPENROUTER_MODEL_CAPABLE=openai/gpt-5.6-luna
OPENROUTER_MODEL_FALLBACKS=qwen/qwen3.5-flash-02-23,openai/gpt-5.6-luna
OPENROUTER_APP_URL=https://github.com/vikramlingam/excelpilot
OPENROUTER_APP_TITLE=ExcelPilot
OPENROUTER_REASONING_EFFORT=low
LLM_TIMEOUT_S=90

# TypeSafe settings for Jev (optional). If TYPESAFE_API_KEY is missing or 401s,
# Jev uses OpenRouter System One, then local Python policy.
TYPESAFE_API_KEY=your_typesafe_key_here
TYPESAFE_BASE_URL=
JEV_MODEL=jev-latest
JEV_FALLBACK_VIA_OPENROUTER=true
JEV_APPROVE_THRESHOLD=0.85
JEV_BLOCK_THRESHOLD=0.15
JEV_VERIFY_ACCEPT_CONFIDENCE=0.80

# Server settings
EXCELPILOT_HOST=127.0.0.1
EXCELPILOT_PORT=8765
EXCELPILOT_ADDIN_ORIGIN=https://localhost:3000
EXCELPILOT_DATA_DIR=~/.excelpilot
EXCELPILOT_REDACTION=pii
EXCELPILOT_ALWAYS_ASK_BEFORE_WRITES=false
EXCELPILOT_PAGE_CELLS=4000
EXCELPILOT_DAILY_BUDGET_USD=5
EXCELPILOT_BRIDGE_PREFERENCE=officejs,xlwings,file

# Observability
LOGFIRE_TOKEN=
LOG_LEVEL=INFO
